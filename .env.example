# PostgreSQL bootstrap/database credentials (local development only)
POSTGRES_DB=file_converter
POSTGRES_USER=file_converter
POSTGRES_PASSWORD=file_converter

# Database role used by Debezium CDC
# Replace with a strong URL-safe random password in real environments.
DEBEZIUM_PASSWORD=replace_with_a_strong_url_safe_password

# Kafka
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka-0:9091
KAFKA_INPUT_TOPIC=files-uploaded
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Kafka Connect / Debezium
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.5.2.Final
DEBEZIUM_GROUP_ID=1
DEBEZIUM_CONFIG_STORAGE_TOPIC=debezium_connect_configs
DEBEZIUM_OFFSET_STORAGE_TOPIC=debezium_connect_offsets
DEBEZIUM_STATUS_STORAGE_TOPIC=debezium_connect_status
DEBEZIUM_TOPIC_PREFIX=file-converter-db
OUTBOX_TOPIC_PREFIX=file-converter

# MinIO (local development only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=attachments
